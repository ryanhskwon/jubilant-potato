# cp .env.example .env
VLLM_IMAGE=vllm/vllm-openai:v0.33.0
MODELS_DIR=/data/models
GPU_ID=0
HOST_BIND=0.0.0.0        # server-local only: 127.0.0.1
HOST_PORT=8000
VLLM_API_KEY=            # required if exposed externally (./serve.sh key)
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=  # empty = admin
CONFIG_DIR=configs       # another folder of <model>.yaml for other hardware
VLLM_USE_DEEP_GEMM=0     # 0 on RTX PRO 6000 (SM120); Hopper (H200) may try 1
